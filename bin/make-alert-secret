#!/usr/bin/env bash
# Build the Alertmanager config Secret from the station's existing Telegram bot config.
# Reads /etc/station-monitor.conf (root only, asks for the sudo password), fills the template,
# and creates or replaces Secret monitoring/alertmanager-telegram. Nothing is written to disk.
#   ssh -t station "bash ~/gpu-platform/bin/make-alert-secret"
set -euo pipefail
cd "$(dirname "$0")/.."
conf=$(sudo cat /etc/station-monitor.conf)
TG_TOKEN=$(printf '%s\n' "$conf" | sed -n 's/^TG_TOKEN=["'\'']\{0,1\}\([^"'\'']*\).*/\1/p')
TG_CHAT=$(printf '%s\n' "$conf" | sed -n 's/^TG_CHAT=["'\'']\{0,1\}\([^"'\'']*\).*/\1/p')
[ -n "$TG_TOKEN" ] && [ -n "$TG_CHAT" ] || { echo "TG_TOKEN / TG_CHAT not found in /etc/station-monitor.conf"; exit 1; }
sed -e "s|bot_token: TOKEN|bot_token: '$TG_TOKEN'|" -e "s|chat_id: CHAT_ID|chat_id: $TG_CHAT|" \
    gitops/monitoring/alertmanager.example.yaml |
  kubectl -n monitoring create secret generic alertmanager-telegram \
    --from-file=alertmanager.yaml=/dev/stdin --dry-run=client -o yaml |
  kubectl apply -f -
echo "Secret monitoring/alertmanager-telegram is ready."
